/* pages/quiz/quiz.wxss */
.quiz-page {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.quiz-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quiz-progress {
  font-size: 28rpx;
  font-weight: 600;
}

.quiz-timer {
  font-size: 30rpx;
  font-weight: 700;
  color: #3B82F6;
  background: #EBF4FF;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.quiz-timer.warning {
  color: #DC2626;
  background: #FEF2F2;
}

.quiz-close {
  font-size: 26rpx;
  color: #6B7280;
  padding: 8rpx 20rpx;
}

/* 题目卡片 */
.question-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.question-num {
  font-size: 22rpx;
  color: #9CA3AF;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  position: relative;
}

.option-item.selected {
  border-color: #3B82F6;
  background: #EBF4FF;
}

.option-item.correct {
  border-color: #059669;
  background: #ECFDF5;
}

.option-item.wrong {
  border-color: #DC2626;
  background: #FEF2F2;
}

.option-key {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #F3F4F6;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
}

.option-mark {
  font-size: 32rpx;
  font-weight: 700;
}

.option-mark.ok { color: #059669; }
.option-mark.bad { color: #DC2626; }

/* 填空 */
.blank-input {
  border: 2rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 反馈 */
.feedback {
  margin-top: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}

.feedback.ok {
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
}

.feedback.bad {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.feedback-answer {
  font-size: 26rpx;
  color: #4B5563;
}

.feedback-analysis {
  font-size: 26rpx;
  color: #3B82F6;
  margin-top: 12rpx;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 导航 */
.quiz-nav {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.quiz-nav .btn {
  flex: 1;
}

/* 答题卡 */
.answer-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.answer-card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.answer-stats {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 400;
}

.answer-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.answer-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.answer-btn.current {
  background: #3B82F6;
  color: #FFFFFF;
}

/* 结果页 */
.result-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.result-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  width: 80%;
}

.result-icon {
  font-size: 80rpx;
}

.result-score {
  font-size: 100rpx;
  font-weight: 700;
  color: #3B82F6;
  margin-top: 20rpx;
}

.result-label {
  font-size: 28rpx;
  color: #9CA3AF;
}

.result-pass {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 20rpx 0 30rpx;
}

.result-pass.pass {
  background: #ECFDF5;
  color: #059669;
}

.result-pass.fail {
  background: #FEF2F2;
  color: #DC2626;
}

.result-stats {
  display: flex;
  margin-bottom: 40rpx;
}

.result-stat {
  flex: 1;
}

.result-stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.result-stat-num.green { color: #059669; }
.result-stat-num.red { color: #DC2626; }
.result-stat-num.gray { color: #6B7280; }

.result-stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}
