/* pages/practice/practice.wxss */
.bank-meta {
  font-size: 24rpx;
  color: #9CA3AF;
}

.mode-tabs {
  display: flex;
  gap: 20rpx;
}

.mode-tab {
  flex: 1;
  background: #F9FAFB;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}

.mode-tab.active {
  border-color: #3B82F6;
  background: #EBF4FF;
}

.mode-icon {
  font-size: 44rpx;
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.mode-desc {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.chip-group {
  display: flex;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.chip.active {
  background: #EBF4FF;
  color: #3B82F6;
  border-color: #3B82F6;
  font-weight: 600;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-half {
  flex: 1;
}
