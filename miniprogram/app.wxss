/* app.wxss - 全局样式 */
page {
  background: #F3F4F6;
  font-size: 28rpx;
  color: #1F2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

/* 布局 */
.container {
  padding: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 按钮 */
.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  text-align: center;
  border: none;
  line-height: 1.5;
}

.btn-primary {
  background: #3B82F6;
  color: #FFFFFF;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #3B82F6;
  border: 1rpx solid #3B82F6;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn-lg {
  padding: 20rpx 32rpx;
  font-size: 30rpx;
}

.btn-sm {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #FFFFFF;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.badge-primary { background: #EBF4FF; color: #3B82F6; }
.badge-green { background: #ECFDF5; color: #059669; }
.badge-red { background: #FEF2F2; color: #DC2626; }
.badge-gray { background: #F3F4F6; color: #6B7280; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9CA3AF;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
}

.list-item-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

/* 统计条 */
.stats-bar {
  display: flex;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3B82F6;
}

.stats-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #F3F4F6;
  margin: 20rpx 0;
}
